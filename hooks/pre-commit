#!/usr/bin/env bash
#
# Pre-commit hook: whenever a watch face changes, regenerate the gallery under
# docs/ and stage it, so every commit/PR that touches a face also updates the
# gallery page. Install it with: scripts/setup-hooks.sh
#
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Only react to staged changes that touch watch faces or the generator itself.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -Eq '^(faces/|scripts/generate-gallery\.mjs$)'; then
    exit 0
fi

if ! command -v node >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: watch faces changed but 'node' is not available to" >&2
    echo "[pre-commit]        regenerate the gallery. Install Node and re-commit," >&2
    echo "[pre-commit]        or run: node scripts/generate-gallery.mjs && git add docs" >&2
    exit 1
fi

echo "[pre-commit] Watch faces changed - regenerating gallery (docs/)..."
node scripts/generate-gallery.mjs
git add docs
echo "[pre-commit] docs/ regenerated and staged."
